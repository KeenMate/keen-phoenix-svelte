<!DOCTYPE html>
<html lang={assigns[:locale] || "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <KeenPhoenixSvelte.runtime context={
      %{
        user: %{
          id: @current_user.id,
          name: @current_user.name,
          title: @current_user.title,
          email: @current_user.email,
          color: @current_user.color
        },
        csrf_token: get_csrf_token(),
        api_base: "/api",
        socket_path: "/socket",
        # Page-wide UI language. Islands localize themselves from this — the
        # server sends the *locale*, never translated strings (see Example.I18n).
        locale: @locale,
        # Authenticates the Phoenix channel socket (chat).
        socket_token: Phoenix.Token.sign(ExampleWeb.Endpoint, "user socket", @current_user.id),
        # Simulated Microsoft Entra / Graph access token for the calendar island —
        # a short-lived, per-user token the app sends as a bearer to the mock Graph
        # service. In a real app this is an on-behalf-of token for graph.microsoft.com.
        tokens: %{
          graph: Phoenix.Token.sign(ExampleWeb.Endpoint, "graph token", @current_user.id)
        }
      }
    } />
    <.live_title default={site_name()} suffix={" · " <> site_name()}>
      {assigns[:page_title]}
    </.live_title>

    <meta name="description" content={site_description()} />
    <meta name="keywords" content={keywords()} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={url(~p"/")} />

    <%!-- Open Graph — link previews (Slack, Teams, LinkedIn, ...) --%>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site_name()} />
    <meta property="og:title" content={og_title()} />
    <meta property="og:description" content={site_description()} />
    <meta property="og:url" content={url(~p"/")} />
    <meta property="og:image" content={url(~p"/images/keenmate-logo.png")} />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content="keen_phoenix_svelte by KeenMate" />

    <%!-- Twitter / X card --%>
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={og_title()} />
    <meta name="twitter:description" content={site_description()} />
    <meta name="twitter:image" content={url(~p"/images/keenmate-logo.png")} />
    <meta name="theme-color" content="#0ea5e9" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Privacy-friendly analytics by Plausible --%>
    <script async src="https://stats.keenmate.services/js/pa-4O93gxhsEAsSFcOEphtyC.js">
    </script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
