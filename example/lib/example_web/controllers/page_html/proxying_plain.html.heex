<Layouts.workspace
  current_user={@current_user}
  active={:proxying_plain}
  title="Proxying (plain page)"
  locale={@locale}
  flash={@flash}
>
  <div class="max-w-4xl mx-auto space-y-10 pb-6">
    <%!-- Intro --%>
    <section>
      <div class="flex items-center gap-2">
        <.icon name="hero-bolt" class="size-7 text-primary" />
        <h1 class="text-2xl font-bold tracking-tight">Same islands, no LiveView</h1>
      </div>
      <p class="mt-3 text-base-content/70">
        This is the <strong>plain-page twin</strong>
        of <.link href={~p"/proxying"} class="link link-primary">/proxying</.link>. The
        exact same two islands, the same modulepreload, the same load-stats panel — but this
        is a dead <strong>controller-rendered page</strong>, so the islands mount via
        <code>mountStatic()</code>
        the instant <code>app.js</code>
        runs, instead of waiting for the <code>KeenSvelte</code>
        LiveView hook to fire after the socket connects.
      </p>
      <p class="mt-3 text-base-content/70">
        Compare the <strong>first render</strong>
        deltas here against the LiveView page. If the gap collapses, that time was
        LiveView-connect overhead — not the island itself.
      </p>
    </section>

    <%!-- The two islands, same as the LiveView page --%>
    <section class="grid gap-6 md:grid-cols-2">
      <div class="card bg-base-100 border border-base-300 rounded-xl p-5 flex flex-col">
        <div class="flex items-center gap-2">
          <code class="text-xs font-mono px-2 py-0.5 rounded bg-primary/10 text-primary">:direct</code>
          <span class="text-sm text-base-content/60">browser → CDN</span>
        </div>
        <div class="mt-4 pt-4 border-t border-base-300">
          <%= if @hello? do %>
            <.app name="hello" id="hello-app" props={%{}}>
              <:placeholder>
                <div class="skeleton h-28 w-full rounded-xl"></div>
              </:placeholder>
            </.app>
          <% else %>
            <p class="text-sm text-base-content/50 italic">
              <code>hello</code> isn't registered in this environment.
            </p>
          <% end %>
        </div>
      </div>

      <div class="card bg-base-100 border border-base-300 rounded-xl p-5 flex flex-col">
        <div class="flex items-center gap-2">
          <code class="text-xs font-mono px-2 py-0.5 rounded bg-primary/10 text-primary">:proxy</code>
          <span class="text-sm text-base-content/60">browser → your app → CDN</span>
        </div>
        <div class="mt-4 pt-4 border-t border-base-300">
          <%= if @metrics? do %>
            <.app name="metrics" id="metrics-app" props={%{}}>
              <:placeholder>
                <div class="skeleton h-28 w-full rounded-xl"></div>
              </:placeholder>
            </.app>
          <% else %>
            <p class="text-sm text-base-content/50 italic">
              <code>metrics</code> isn't registered in this environment.
            </p>
          <% end %>
        </div>
      </div>
    </section>

    <%!-- Same load-stats panel — but no phx-hook (dead page). app.js bootstraps
    it from the data-proxy-load-stats attribute after mountStatic(). --%>
    <section :if={@watch != []} class="card bg-base-100 border border-base-300 rounded-xl p-6">
      <div class="flex items-center gap-2">
        <.icon name="hero-clock" class="size-6 text-primary" />
        <h2 class="text-lg font-semibold">Live load statistics (plain page)</h2>
      </div>
      <p class="mt-2 text-base-content/70">
        Measured exactly like the LiveView page — the <strong>Performance API</strong>
        for request/load, a <strong>MutationObserver</strong>
        for first render. Times are milliseconds since the page started loading.
        Reload to watch them again.
      </p>
      <div
        id="proxy-load-stats"
        data-proxy-load-stats
        data-apps={Jason.encode!(@watch)}
        class="mt-4 grid gap-4 sm:grid-cols-2"
      >
      </div>
    </section>
  </div>

  <:aside>
    <Layouts.info_panel title="Plain page vs LiveView">
      <p>
        Both pages render identical islands with an identical <code>modulepreload</code>.
        The only difference is <strong>what triggers the mount</strong>.
      </p>
      <:wire label="mountStatic">
        Scans <code>[data-app]</code>
        as soon as the deferred <code>app.js</code>
        parses — no socket, no round-trip.
      </:wire>
      <:wire label="LiveView hook">
        On <code>/proxying</code>, the island mounts only after
        <code>liveSocket.connect()</code>
        and the LiveView client mount.
      </:wire>
      <:wire label="what to read">
        The <code>first render</code>
        delta (<code>loaded → rendered</code>) is the number to compare.
      </:wire>
    </Layouts.info_panel>
  </:aside>
</Layouts.workspace>
