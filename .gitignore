# Machine-local Claude settings (the shared .claude/commands/ stay tracked)
.claude/settings.local.json

# Built Svelte app bundles in the example (produced by the asset build)
/example/priv/static/apps/

# Vite's transient ESM-config temp files (left behind by interrupted builds)
*.vite.config.*.timestamp-*.mjs

# OS / editor cruft
.DS_Store
Thumbs.db
