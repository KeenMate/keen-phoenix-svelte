{
  "name": "@keenmate/phoenix_svelte",
  "version": "1.0.0-rc06",
  "description": "Auto-mount compiled Svelte (React, Lit, …) apps into Phoenix (hook + AppsManager).",
  "type": "module",
  "main": "assets/js/keen_phoenix_svelte/index.js",
  "module": "assets/js/keen_phoenix_svelte/index.js",
  "exports": {
    ".": "./assets/js/keen_phoenix_svelte/index.js",
    "./vite": "./assets/vite/config.js"
  },
  "files": [
    "assets"
  ],
  "peerDependencies": {
    "phoenix": "^1.7.0 || ^1.8.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/vite-plugin-svelte": {
      "optional": true
    },
    "svelte-preprocess": {
      "optional": true
    }
  },
  "license": "MIT",
  "homepage": "https://keen-phoenix-svelte.keenmate.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeenMate/keen-phoenix-svelte"
  }
}
